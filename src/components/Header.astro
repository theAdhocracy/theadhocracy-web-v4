			alt="Stylised, cartoon version of Murray's face."
			height="160"
			width="150"
		/>
		<p>theAdhocracy</p>
	</a>
	<nav>
		<ul role="list" data-layout="flex">
			<li>
				<a href="/">Home</a>
			</li>
			<li>
				<a href="/articles">Articles</a>
			</li>
			<li>
				<a href="/journal">Journal</a>
			</li>
			<li>
				<a href="/notes">Notes</a>
			</li>
			<li>
