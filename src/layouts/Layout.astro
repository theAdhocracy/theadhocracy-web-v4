---
import "@/styles/global.css";
import metadata from "@/data/metadata.json";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
	title?: string;
	meta?: {
		desc?: string;
		image?: string;
		type?: string;
		category?: string;
		tags?: string;
		published?: string;
		updated?: string;
	};
}

// Handle props
const { title, meta } = Astro.props;
const {
	title: defaultTitle,
	description,
	siteImage,
	siteUrl,
	author,
} = metadata;

// Current page path
const path = Astro.url.pathname;

// Combine with page-specific overrides passed as prop
// TODO: Review what (if any) of this is still needed and throw out content no longer wanted
const seo = {
	title: `${defaultTitle}${title ? ` | ${title}` : ""}`,
	description:
		meta && meta.desc ? meta.desc.replace(/(<([^>]+)>)/gi, "") : description,
	image: meta && meta.image ? meta.image : siteImage,
	url: `${siteUrl}${path}`,
	type: meta && meta.type ? meta.type : "website",
};

// TODO: Test IndieAuth

// TODO: Archive this layout once all pages have migrated to the new system
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

		{/* IndieWeb */}
		<link
			rel="webmention"
			href="https://webmention.io/theadhocracy.co.uk/webmention"
		/>
		<link href="https://github.com/theAdhocracy" rel="me" />

		{/* RSS */}
		<link
			rel="alternate"
			type="application/rss+xml"
			title="theAdhocracy | RSS"
			href="/rss.xml"
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="theAdhocracy | Reviews"
			href="/rss-reviews.xml"
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="theAdhocracy | Notes"
			href="/rss-notes.xml"
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="theAdhocracy | Articles"
			href="/rss-articles.xml"
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="theAdhocracy | Journal"
			href="/rss-journal.xml"
		/>

		{/* Meta Standards */}
		<meta name="title" content={seo.title} />
		<meta name="description" content={seo.description} />
		<meta name="image" content={seo.image} />
		<meta name="author" content={author} />
		<meta name="robots" content="index, follow" />
		<meta name="generator" content={Astro.generator} />

		{/* GNU */}
		<meta http-equiv="X-Clacks-Overhead" content="GNU Terry Pratchett" />

		{/* Open Graph (Social Cards) */}
		<meta property="og:type" content={seo.type} />
		<meta property="og:title" content={seo.title} />
		<meta property="og:url" content={seo.url} />
		<meta property="og:description" content={seo.description} />
		<meta property="og:image" content={seo.image} />
		<meta property="og:site_name" content={defaultTitle} />

		{/* Homepage profile info (OpenGraph; homepage only) */}
		{
			path === "/" && (
				<>
					<meta property="profile:first_name" content="Murray" />
					<meta property="profile:last_name" content="Champernowne" />
				</>
			)
		}

		{/* Article details (OpenGraph) */}
		{
			seo.type === "article" && (
				<>
					<meta property="article:author" content={siteUrl} />
					{meta?.category ? (
						<meta property="article:section" content={meta.category} />
					) : (
						""
					)}
					{meta?.tags ? (
						<meta property="article:tag" content={meta.tags} />
					) : (
						""
					)}
					{meta?.published ? (
						<meta
							property="article:published_time"
							content={new Date(meta?.published).toISOString().split("T")[0]}
						/>
					) : (
						""
					)}
					{meta?.updated ? (
						<meta
							property="article:modified_time"
							content={new Date(meta?.updated).toISOString().split("T")[0]}
						/>
					) : (
						""
					)}
				</>
			)
		}

		<title>{seo.title}</title>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	@layer base {
		@container style(--css-enabled: true) {
			/* Define text in responsive font-sizes */
			h1 {
				font-size: 2rem;
				margin: 0.67em 0;
			}
			h2 {
				font-size: 1.5rem;
			}
			h3 {
				font-size: 1.17rem;
			}
			h4 {
				font-size: 1rem;
			}
			h5 {
				font-size: 0.83rem;
			}
			h6 {
				font-size: 0.67rem;
			}
			p {
				font-size: 1rem;
			}

			/* Improve readability */
			h1,
			h2,
			h3,
			h4,
			h5,
			h6,
			p,
			ul,
			ol,
			dl,
			address {
				line-height: 1.7;
				word-break: break-word;
			}

			/* General fixes */
			pre {
				white-space: pre-wrap; /* Overflow by default is bad. */
			}
			hr {
				border: 0.5px solid;
			}
			nav ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			code,
			pre {
				font-family: "Consolas", "Courier New", monospace;
			}

			dd {
				margin: 0;
			}

			/* Multimedia */
			img,
			video,
			canvas,
			audio,
			iframe,
			embed,
			object {
				display: block;
			}
			img,
			video {
				max-width: 100%; /* Make images and video flexible by default. */
				height: auto; /* Ensure images and video maintain their aspect ratio when max-width comes into play. */
			}
			img {
				border-style: none; /* Remove the border on images inside links in IE 10 and earlier. */
			}

			/* Utility Classes */
			.flat-list {
				display: flex;
				flex-wrap: wrap;
				width: 100%;
				justify-content: space-evenly;
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.flat-list > li + li {
				margin-left: 1rem;
			}

			ul[role="list"] {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			html {
				scroll-behavior: smooth;
			}

			html,
			body {
				margin: 0;
				padding: 0;
				font-size: 16px;
				-webkit-text-size-adjust: 100%;
				min-height: 100%;
				font-family:
					"Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Cantarell", "Fira Sans",
					"Droid Sans", "Helvetica Neue", sans-serif;
			}

			body {
				min-height: 100vh;
				background-color: var(--colour-bg);
				color: hsl(212, 20%, 20%);
				display: grid;
				grid-template-columns: repeat(10, 1fr);
				grid-template-rows:
					max-content minmax(auto, 3rem)
					max-content auto minmax(100px, max-content);
				grid-template-areas:
					"header header header header header header header header header header"
					"header header header header header header header header header header"
					"about about about about about about about about about about"
					"content content content content content content content content content content"
					"footer footer footer footer footer footer footer footer footer footer";
			}

			@media screen and (min-width: 900px) {
				body {
					grid-template-areas:
						"header header header header header header header header header header"
						"header header header header header header header header header header"
						". . about about about about about about . ."
						". . content content content content content content . ."
						"footer footer footer footer footer footer footer footer footer footer";
				}
			}

			.microformats {
				display: none;
			}

			#about {
				grid-area: about;
				max-width: 100vw;
				padding: 2rem;
			}

			#about h1 {
				color: var(--pink);
				margin-bottom: 0;
			}

			.profile_photo {
				width: 100%;
				max-width: 12rem;
				border-radius: 50%;
				float: left;
				margin-right: 2rem;
				shape-outside: circle(50%);
			}

			#content {
				grid-area: content;
				max-width: 100%;
				padding: 1rem;
				background-color: white;
			}

			#content > header {
				margin-bottom: 2rem;
				border-bottom: 5px solid var(--orange);
				border-image: linear-gradient(90deg, var(--orange), var(--yellow)) 1;
			}

			#content > header:has(.subtitle) {
				display: flex;
				flex-wrap: wrap;
			}

			#content h1,
			#content > header h2:not(.subtitle, .review-title) {
				display: inline-block;
				margin: 0 0 0.2rem 0;
				background: linear-gradient(90deg, var(--orange), var(--yellow));
				-webkit-text-fill-color: transparent;
				-webkit-background-clip: text;
				background-clip: text;
				color: var(--orange); /* fallback if gradients aren't suppported */
				font-size: 2rem;
			}

			#content > header .subtitle {
				display: inline;
				margin: 0;
				margin-inline-start: auto;
				place-self: center;
				color: var(--orange);
				font-size: 1.2rem;
			}

			#content > h2 {
				display: inline-block;
				margin: 3rem 0 1.5rem;
				width: 100%;
				background: linear-gradient(90deg, var(--pink), var(--orange));
				-webkit-text-fill-color: transparent;
				-webkit-background-clip: text;
				background-clip: text;
				border-bottom: 5px solid var(--orange);
				border-image: linear-gradient(90deg, var(--orange), var(--yellow)) 1;
				color: var(--pink); /* fallback if gradients aren't suppported */
			}

			span[role="img"] {
				-webkit-text-fill-color: #000000;
			}

			#content h1.article-header {
				display: block;
				margin-left: auto;
				margin-right: auto;
				max-width: var(--main);
			}

			footer.page-navigation {
				grid-column: 1 / -1;
				display: flex;
				flex-wrap: wrap;
			}

			footer.page-navigation > a {
				width: 100%;
				max-width: 20rem;
			}

			.content-grid > a:last-child,
			footer.page-navigation > a,
			#content a.bold-link {
				margin: 0 auto;
				grid-column: 1 / -1;
				margin-bottom: 0.75rem;
				padding: 1rem;
				border-radius: 0.5rem;
				background: linear-gradient(135deg, var(--pink), var(--yellow));
				font-size: 1.5rem;
				color: white;
				text-align: center;
				text-transform: uppercase;
				text-decoration: none;
				font-weight: 500;
				letter-spacing: 0.1rem;
			}

			#content a.bold-link {
				display: block;
				margin-top: 2rem;
			}

			.banner-text {
				text-align: center;
				font-size: 1.2rem;
				color: var(--green);
				font-weight: bold;
			}

			.banner-text a {
				color: var(--green);
				text-decoration: underline var(--pink);
				text-decoration-style: wavy;
				text-decoration-thickness: 1.5px;
				text-underline-offset: 0.4rem;
			}

			.banner-text a:hover {
				text-underline-offset: 0.6rem;
			}

			#sidebar {
				grid-area: sidebar;
				padding: 2rem;
			}

			/* Index Content Grid */

			.content-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
				grid-gap: 3rem;
			}

			/* Journal */

			.journal-section {
				grid-column: 1;
				background-image: linear-gradient(180deg, var(--grey), white);
			}

			.journal-section > h3 {
				margin: 0;
				padding: 0.25rem 1rem 0.5rem 1rem;
				background-image: linear-gradient(90deg, var(--pink), var(--yellow));
				color: white;
				font-size: 1.5rem;
			}

			.year-break {
				position: relative;
				z-index: 1;
				padding: 0.3rem 0;
				grid-column: 1 / -1;
				background-color: #ffffff;
				color: var(--green);
				font-weight: bold;
				text-align: center;
				letter-spacing: 0.25em;
			}

			.year-break h2 {
				background-color: #ffffff;
				width: max-content;
				margin: 0 auto;
				padding: 0 1em;
				font-size: 1.17rem;
			}

			.year-break::after {
				content: "";
				display: block;
				position: absolute;
				top: 50%;
				z-index: -1;
				width: 100%;
				height: 3px;
				background-color: var(--green);
			}

			/* Desktop */

			@media screen and (min-width: 400px) {
				#header a h1 {
					background-image: linear-gradient(
						90deg,
						black 15%,
						var(--blue),
						var(--lightblue),
						var(--green),
						var(--yellow),
						var(--orange),
						var(--pink),
						black 75%
					);
				}

				#content {
					padding: 2rem;
				}

				.content-grid {
					grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
				}
			}
		}
	}
</style>
