---
import type { GetStaticPaths } from "astro";

import PageNav from "@/components/PageNav.astro";
import Layout from "@/layouts/Layout.astro";
import { fetchCraftAPI } from "@/utilities/craft";

// Generate static pages
export const getStaticPaths = (async ({ paginate }) => {
	const notes = await fetchCraftAPI("notes.json");

	return paginate(notes, { pageSize: 12 });
}) satisfies GetStaticPaths;

// Handle props
const { page } = Astro.props;

// TODO: Add notes section; should show latest pages. Unsure if above/below bookmarks
---

<Layout title="Notes">
	<main id="content">
		<header>
			<h1>Explore My Notes</h1>
		</header>
		<section id="bookmarks">
			<h2>Bookmarks</h2>
			{
				page.data.map((bookmark: any) => {
					return (
						<article data-note-type="bookmark">
							<header>
								<a href={"/note/" + bookmark.slug}>
									<span role="img" aria-label="Bookmark">
										🔖
									</span>
									<h2>{bookmark.title}</h2>
									<span role="img" aria-label="Read Bookmark">
										↬
									</span>
								</a>
							</header>
							<Fragment set:html={bookmark.snippet} />
							<footer>
								<dl>
									<span>
										<dt>Bookmarked:</dt>
										<dd>
											<time datetime={bookmark.date.html}>
												{bookmark.date.date}
											</time>
										</dd>
									</span>
									<span>
										<dt>Source:</dt>
										<dd>
											<a href={bookmark.source}>{bookmark.attribution}</a>
										</dd>
									</span>
									<span>
										<dt>Categories:</dt>
										<dd>
											<ul role="list">
												{bookmark.categories.map((category: string) => {
													return (
														<li
															class={category === bookmark.silo ? "silo" : null}
														>
															{category}
														</li>
													);
												})}
											</ul>
										</dd>
									</span>
									<span>
										<dt>Tags:</dt>
										<dd>
											<ul role="list">
												{bookmark.tags.map((tag: string) => {
													const url = `/search?query=${tag}&filter=&page=`;

													return (
														<li>
															<a href={url}>{tag}</a>
														</li>
													);
												})}
											</ul>
										</dd>
									</span>
								</dl>
							</footer>
						</article>
					);
				})
			}
			<PageNav
				currentPage={page.currentPage}
				totalPages={page.lastPage}
				pageRoot="/notes"
				type="regular"
			/>
		</section>
	</main>
</Layout>

<style>
	#bookmarks {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
		gap: 1rem;
		justify-content: center;
		margin-block-start: 1rem;
		font-family: var(--font-serif);

		background-color: white;
		border-radius: 6px;

		& > h2 {
			grid-column: 1 / -1;
		}

		article {
			--content-padding: 0;

			@media (inline-size > 450px) {
				--content-padding: 2.4rem;
			}

			block-size: 100%;
			max-inline-size: 30rem;
			display: grid;
			grid-template-columns: max-content 1fr max-content;
			gap: 1rem;
			padding-block: 0.75rem 1rem;
			align-content: start;
			justify-content: center;

			header {
				grid-column: 1 / -1;
				display: grid;
				grid-template-columns: subgrid;
				align-items: center;
				gap: 0.25rem 1rem;
				min-inline-size: 100%;
				margin-block-end: 0.25rem;

				h2 {
					margin-block: 0;
					line-height: 1.2;
					font-family: var(--font-sans);
					text-decoration-line: underline;
					text-decoration-color: #e0043f;
					text-decoration-style: double;
					text-underline-offset: 0.1em;
					text-decoration-thickness: 0.1em;
					text-wrap: balance;
				}

				a {
					display: grid;
					grid-column: 1 / -1;
					grid-template-columns: subgrid;
					align-items: center;
					color: #e0043f;
					text-decoration: none;
				}

				a:is(:hover, :focus-visible) h2 {
					text-underline-offset: 0.25em;
				}

				span {
					place-self: start;
					line-height: 2.12;
				}
			}

			& > :global(p) {
				grid-column: 2;
				margin-block: 0;
				padding-inline: var(--content-padding);
				font-style: italic;
				font-synthesis-style: none;
			}

			footer {
				grid-column: 2;
				padding-block-start: 0.5rem;
				padding-inline: var(--content-padding);
			}

			dl,
			ul,
			dl > span {
				display: flex;
				flex-wrap: wrap;
				list-style: none;
				gap: 0 1rem;
				padding: 0;
				margin: 0;
			}

			ul {
				gap: 0.25rem 0.5rem;
				font-size: 0.8rem;
				place-self: center;

				li {
					--currentBGColor: var(--yellow);

					padding-inline: 0.2rem;
					background-color: var(--currentBGColor);

					a {
						color: black;
						text-decoration: none;
					}

					&:has(a:hover, a:focus) {
						background-color: color-mix(
							in srgb,
							var(--currentBGColor),
							white 50%
						);
					}
				}

				.silo {
					--currentBGColor: var(--green);

					& ~ li {
						--currentBGColor: color-mix(in srgb, var(--green), white 50%);
					}
				}
			}

			dl > span {
				gap: 0 0.25rem;
				flex-wrap: nowrap;
			}

			dt {
				white-space: nowrap;
				font-weight: bold;
			}

			dd {
				display: flex;
			}
		}

		> footer {
			margin: 1.5rem auto 0;
			text-align: center;
			font-style: italic;
			font-weight: bold;
			color: transparent;
			background-clip: text;
			background-image: linear-gradient(
				90deg,
				var(--orange) 20%,
				var(--yellow),
				var(--blue),
				var(--lightblue),
				var(--green),
				var(--yellow),
				var(--orange),
				var(--pink),
				var(--pink),
				var(--orange) 75%
			);
			background-position: 100%;
			background-size: 400% auto;
			animation: RainbowRoad 5000ms ease-in-out infinite;
		}
	}
</style>
