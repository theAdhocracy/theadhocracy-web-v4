---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { fetchCraftAPI } from "@/utilities/craft";

// #1 Determine if there are filters being applied
const params = Astro.url.searchParams;

const paramFilters =
	params.get("filter")?.replaceAll(" ", "%20").replaceAll("&", "%26") || "";
const paramTypes = params.get("type") || "";
const paramQuery = params.get("query") || "";
const paramPage = params.get("page") || 0;

// #2 Fetch possible filters/categories
const filters = await fetchCraftAPI(
	`https://cms.theadhocracy.co.uk/api/category/writing?q=${paramQuery}&c=${paramFilters}&t=${paramTypes}`
);

const types = await fetchCraftAPI(
	`https://cms.theadhocracy.co.uk/stats/blog?q=${paramQuery}&c=${paramFilters}`
);

// #3 Query search API
const searchResults = await fetchCraftAPI(
	`https://cms.theadhocracy.co.uk/search/articles?q=${paramQuery}&c=${paramFilters}&t=${paramTypes}&p=${paramPage}`
);

// #4 Set UI state

// Selected filters
let validFilters = new Set();

if (params && paramFilters) {
	searchResults.map((result: any) => {
		result.categories.forEach((category: any) => {
			validFilters.add(category);
		});
	});
}

// Type filters
let noteTotal = types?.search.notes || 0;
let articleTotal = types?.search.articles || 0;
let journalTotal = types?.search.journals || 0;

if (paramTypes) {
	if (!paramTypes.includes("notes")) noteTotal = 0;
	if (!paramTypes.includes("articles")) articleTotal = 0;
	if (!paramTypes.includes("journals")) journalTotal = 0;
}

// #5 Handle new search query
if (Astro.request.method === "POST") {
	try {
		const data = await Astro.request.formData();

		const query = data.get("search");
		const page = data.get("page") || 0;

		// Condense filters into a single string
		let filterValues: string[] = [];
		filters.forEach((filter: any) => {
			if (data.get(filter.title)) {
				filterValues.push(filter.title);
			}
		});

		// Condense types into a single string
		let typeValues: string[] = [];
		if (data.get("notes")) {
			typeValues.push("notes");
		}
		if (data.get("articles")) {
			typeValues.push("articles");
		}
		if (data.get("journals")) {
			typeValues.push("journals");
		}

		const searchQuery = `/search?query=${query}&filter=${filterValues.join("|").replaceAll(" ", "%20").replaceAll("&", "%26")}&type=${typeValues.join("|")}&page=${page}`;

		// Redirect with new search term
		return Astro.redirect(searchQuery);
	} catch (error) {
		if (error instanceof Error) {
			console.error(error.message);
		}
	}
}

// Add whimsy
const powerSources = [
	"the Wee Free Men",
	"unicorns snorting pixie sticks",
	"the arcane",
	"electric sheep",
	"42 answers to the ultimate question",
	"infinite (baffled) monkeys",
	"a solitary bee",
	"L-Space",
	"three API requests in a trenchcoat",
	"hextech",
	"sentient sand",
];

// TODO: Add a filter onto the tags, title, snippet, and (maybe) category to find the search term and highlight it. Thinking a pseudo-element that draws a circle (not quite complete) around it.
---

<Layout title="Search">
	<main id="content">
		<h1 id="search-title">Search</h1>
		<search role="search">
			<form class="search-form" method="post">
				<input
					type="search"
					name="search"
					placeholder={`Search archives`}
					aria-labelledby="search-title"
					value={paramQuery}
				/>
				<div>
					<button type="reset" title="Reset search">
						<span role="img" aria-label="Reset search"> 🔄 </span>
					</button>
					<button type="submit" title="Submit search">
						<span role="img" aria-label="Submit search"> ▶ </span>
					</button>
				</div>
				<fieldset>
					<legend>Post types:</legend>
					<label
						for="filter_articles"
						data-empty={articleTotal === 0 ? "true" : "false"}
					>
						<input
							type="checkbox"
							id="filter_articles"
							name="articles"
							disabled={articleTotal === 0}
							checked={paramTypes?.includes("articles")}
						/>
						Articles <span>{articleTotal}</span>
					</label>
					<label
						for="filter_notes"
						data-empty={noteTotal === 0 ? "true" : "false"}
					>
						<input
							type="checkbox"
							id="filter_notes"
							name="notes"
							disabled={noteTotal === 0}
							checked={paramTypes?.includes("notes")}
						/>
						Notes <span>{noteTotal}</span>
					</label>
					<label
						for="filter_journals"
						data-empty={journalTotal === 0 ? "true" : "false"}
					>
						<input
							type="checkbox"
							id="filter_journals"
							name="journals"
							disabled={journalTotal === 0}
							checked={paramTypes?.includes("journals")}
						/>
						Journals <span>{journalTotal}</span>
					</label>
				</fieldset>
				<fieldset>
					<legend>Categories:</legend>
					{
						filters?.map((filter: any) => {
							const id = filter.id;

							// Check whether a category filter is selected
							const isInFilterSelection = params
								.get("filter")
								?.includes(filter.title);

							// Determine total based on if it is a valid filter or not
							const total =
								validFilters.size > 0 && !validFilters?.has(filter.title)
									? 0
									: filter.total;

							return (
								<label
									for={`check_${id}`}
									data-empty={total === 0 ? "true" : "false"}
								>
									<input
										type="checkbox"
										id={`check_${id}`}
										name={filter.title}
										disabled={total === 0}
										checked={isInFilterSelection}
									/>
									{filter.title} <span>{total}</span>
								</label>
							);
						})
					}
				</fieldset>
				<input type="number" name="page" hidden />
			</form>
			<section class="search-results">
				{
					searchResults?.map((result: any) => {
						const type = result.type === "notes" ? "Note" : "Article";
						const typeIcon = type === "Note" ? "🔖" : "📖";

						return (
							<article>
								<header>
									<span role="img" aria-label={type}>
										{typeIcon}
									</span>
									<h2>{result.title}</h2>
									<a href={result.uri}>
										Read {type}{" "}
										<span role="img" aria-hidden="true">
											↬
										</span>
									</a>
								</header>
								<Fragment set:html={result.snippet} />
								<footer>
									<dl>
										<span>
											<dt>Published:</dt>
											<dd>
												<time datetime={result.date.html}>
													{result.date.date}
												</time>
											</dd>
										</span>
										<span>
											<dt>Categories:</dt>
											<dd>
												<ul role="list">
													{result.categories.map((category: string) => {
														return (
															<li
																class={category === result.silo ? "silo" : null}
															>
																{category}
															</li>
														);
													})}
												</ul>
											</dd>
										</span>
										<span>
											<dt>Tags:</dt>
											<dd>
												<ul role="list">
													{result.tags.map((tag: string) => {
														const url = `/search?query=${tag}&filter=&page=`;

														return (
															<li>
																<a href={url}>{tag}</a>
															</li>
														);
													})}
												</ul>
											</dd>
										</span>
									</dl>
								</footer>
							</article>
						);
					})
				}
				{
					searchResults?.length === 0 && (
						<p>
							Sorry, I don't seem to have written anything that niche... yet!
						</p>
					)
				}
				<footer>
					Ad hoc search, powered by {
						powerSources[Math.floor(Math.random() * powerSources.length)]
					}.
				</footer>
			</section>
		</search>
	</main>
</Layout>

<script is:inline>
	// Reset
	const resetButton = document.querySelector("button[type='reset']");

	resetButton.addEventListener("click", () => {
		window.location.search = "";
	});
</script>

<style>
	:root {
		--font-serif: "Sitka Text", Charter, "Bitstream Charter", Cambria, serif;
		--font-sans: "Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Cantarell",
			"Fira Sans", "Droid Sans", "Helvetica Neue", sans-serif;
	}

	@keyframes RainbowRoad {
		from {
			background-position: left center;
		}

		to {
			background-position: right center;
		}
	}

	/* TODO: Remove this once global styles are determined */
	:global(#content) {
		background-color: transparent;
	}

	.search-form {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.4rem;
		align-items: center;
		padding-block: 1rem 1.5rem;

		input[type="search"] {
			min-width: min(80vw, 15rem);
			flex-grow: 1;
			border-radius: 6px;
			border: double 3px transparent;
			padding: 0.5rem;
			background-clip: padding-box, border-box;
			background-image: linear-gradient(#ffffff, #ffffff),
				linear-gradient(90deg, var(--orange), var(--yellow));
			background-origin: border-box;
			color: var(--darkgrey);

			&:focus {
				background-image: linear-gradient(#ffffff, #ffffff),
					linear-gradient(
						90deg,
						var(--orange) 20%,
						var(--yellow),
						var(--blue),
						var(--lightblue),
						var(--green),
						var(--yellow),
						var(--orange),
						var(--pink),
						var(--pink),
						var(--orange) 75%
					);
				background-position: right center;
				background-size: 400% auto;
				animation: RainbowRoad 5000ms ease-in-out infinite;
				outline: none;
			}
		}

		> div {
			display: flex;
			gap: 0.4rem;
			max-width: max-content;
			margin-inline-start: auto;
		}

		button {
			font-size: 1.2rem;
			padding: 0.3rem;
			border: 0;
			background-color: var(--blue);
			border-radius: 3px;
			cursor: pointer;
			font-family: "Segoe UI Emoji";
		}

		fieldset {
			display: flex;
			flex-wrap: wrap;
			gap: 0.6rem 0.6rem;
			width: 100%;
			margin: 0;
			padding: 0;
			border: none;
			font-size: 0.8rem;

			legend {
				margin-block-end: 0.4rem;
				font-family: var(--font-serif);
				font-weight: bold;
			}

			label {
				position: relative;
				padding-inline-start: 0.4rem;
				outline: 2px solid var(--green);
				outline-offset: -2px;
				background-color: white;

				input[type="checkbox"] {
					position: absolute;
					inset: 0;
					opacity: 0;
					margin: 0;
					width: 100%;
				}

				span {
					display: inline-flex;
					justify-content: center;
					align-items: center;
					width: 2rem;
					height: 1.5rem;
					margin-inline-start: 1rem;
					border: 2px solid var(--green);
					background-color: var(--green);
				}
			}

			label:has(:checked) {
				outline-color: var(--yellow);
				background-color: var(--yellow);

				span {
					border-color: var(--yellow);
					background-color: white;
				}
			}

			label[data-empty="true"]:not(:has(:checked)) {
				display: none;
				outline-color: var(--grey);

				span {
					border-color: var(--grey);
					background-color: var(--grey);
				}

				@media (width > 800px) {
					display: block;
				}
			}

			label * {
				cursor: pointer;
			}
		}
	}

	.search-results {
		display: flex;
		flex-direction: column;
		margin-block-start: 1rem;
		font-family: var(--font-serif);

		background-color: white;
		padding: 1rem;
		border-radius: 6px;

		article {
			--content-padding: 0;

			@media (width > 450px) {
				--content-padding: 2.4rem;
			}

			padding-block: 0.75rem 1rem;
			border-block-start: 3px solid var(--grey);

			&:first-of-type {
				border: none;
			}

			header {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.25rem 1rem;
				margin-block-end: 0.25rem;

				h2 {
					flex-grow: 1;
					margin-block: 0;
					line-height: 1.2;
					font-family: var(--font-sans);
				}

				a {
					color: #e0043f;
					text-decoration-style: double;
					text-underline-offset: 0.1em;
					text-decoration-thickness: 0.1em;
				}

				a:hover,
				a:focus-visible {
					text-underline-offset: 0.25em;
				}

				span {
					place-self: start;
					line-height: 2.12;
				}
			}

			& > :global(p) {
				max-width: 46em;
				margin-block: 0;
				padding-inline: var(--content-padding);
				font-style: italic;
				font-synthesis-style: none;
			}

			footer {
				padding-block-start: 0.5rem;
				padding-inline: var(--content-padding);
			}

			dl,
			ul,
			dl > span {
				display: flex;
				flex-wrap: wrap;
				list-style: none;
				gap: 0 1rem;
				padding: 0;
				margin: 0;
			}

			ul {
				gap: 0.25rem 0.5rem;
				font-size: 0.8rem;
				place-self: center;

				li {
					--currentBGColor: var(--yellow);

					padding-inline: 0.2rem;
					background-color: var(--currentBGColor);

					a {
						color: black;
						text-decoration: none;
					}

					&:has(a:hover, a:focus) {
						background-color: color-mix(
							in srgb,
							var(--currentBGColor),
							white 50%
						);
					}
				}

				.silo {
					--currentBGColor: var(--green);

					& ~ li {
						--currentBGColor: color-mix(in srgb, var(--green), white 50%);
					}
				}
			}

			dl > span {
				gap: 0 0.25rem;
				flex-wrap: nowrap;
			}

			dt {
				white-space: nowrap;
				font-weight: bold;
			}

			dd {
				display: flex;
			}
		}

		> footer {
			margin: 1.5rem auto 0;
			text-align: center;
			font-style: italic;
			font-weight: bold;
			color: transparent;
			background-clip: text;
			background-image: linear-gradient(
				90deg,
				var(--orange) 20%,
				var(--yellow),
				var(--blue),
				var(--lightblue),
				var(--green),
				var(--yellow),
				var(--orange),
				var(--pink),
				var(--pink),
				var(--orange) 75%
			);
			background-position: 100%;
			background-size: 400% auto;
			animation: RainbowRoad 5000ms ease-in-out infinite;
		}
	}
</style>
