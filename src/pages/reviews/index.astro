---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import SearchRating from "@/components/SearchRating.astro";
import { fetchCraftAPI } from "@/utilities/craft";
import { getStarRating } from "@/utilities/content";

// Fetch data
const reviewsData = await fetch("https://cms.theadhocracy.co.uk/reviews.json", {
	method: "GET",
	headers: {
		"content-type": "application/json",
		Authorization: `Bearer ${import.meta.env.CRAFT_API_KEY}`,
	},
});
const reviewsResponse = await reviewsData.json();

const seriesData = await fetch("https://cms.theadhocracy.co.uk/series.json", {
	method: "GET",
	headers: {
		"content-type": "application/json",
		Authorization: `Bearer ${import.meta.env.CRAFT_API_KEY}`,
	},
});
const seriesResponse = await seriesData.json();

const collectionData = await fetch(
	"https://cms.theadhocracy.co.uk/collections.json",
	{
		method: "GET",
		headers: {
			"content-type": "application/json",
			Authorization: `Bearer ${import.meta.env.CRAFT_API_KEY}`,
		},
	}
);
const collectionResponse = await collectionData.json();

// Set root pathways for data
const reviews = reviewsResponse.data.slice(0, 6);

const series = seriesResponse.data
	.sort((a: any, b: any) => {
		// Gets the most recently updated review for each series, and sorts in descending order (so most recent review first)
		const aUpdated = a.reviews?.reduce((prev: any, current: any) => {
			return prev && prev.updated > current.updated ? prev : current;
		}, null);

		const bUpdated = b.reviews?.reduce((prev: any, current: any) => {
			return prev && prev.updated > current.updated ? prev : current;
		}, null);

		return Date.parse(bUpdated?.updated) - Date.parse(aUpdated?.updated);
	})
	.slice(0, 6);

const collections = collectionResponse.data
	.sort((a: any, b: any) => {
		// Gets the most recently updated review for each series, and sorts in descending order (so most recent review first)
		const aUpdated = a.reviews?.reduce((prev: any, current: any) => {
			return prev && prev.updated > current.updated ? prev : current;
		}, null);

		const bUpdated = b.reviews?.reduce((prev: any, current: any) => {
			return prev && prev.updated > current.updated ? prev : current;
		}, null);

		return Date.parse(bUpdated?.updated) - Date.parse(aUpdated?.updated);
	})
	.slice(0, 6);

// Define media types
const mediaOptions = {
	film: {
		title: "Film",
		icon: "🎬",
		slug: "film",
	},
	tv: {
		title: "TV",
		icon: "📺",
		slug: "tv",
	},
	book: {
		title: "Book",
		icon: "📚",
		slug: "book",
	},
	podcast: {
		title: "Podcast",
		icon: "🎙",
		slug: "podcast",
	},
	"video-game": {
		title: "Video Game",
		icon: "🕹",
		slug: "videogame",
	},
	"board-game": {
		title: "Board Game",
		icon: "🎲",
		slug: "boardgame",
	},
	thing: {
		title: "Thing",
		icon: "🛒",
		slug: "thing",
	},
};

// Configure search (Craft)

// #1 Determine if there are filters being applied
const params = Astro.url.searchParams;

const paramTypes = params.get("type") || "";
const paramQuery = params.get("query") || "";
const paramMin = params.get("min") || "";
const paramMax = params.get("max") || "";

const range = !!paramMin && !!paramMax ? `${paramMin}|${paramMax}` : "";

// #2 Fetch possible filters/categories
const mediaTypes = await fetchCraftAPI(
	`https://cms.theadhocracy.co.uk/api/category/media?q=${paramQuery}&m=${paramTypes}&r=${range}`
);

// #3 Query search API
const searchResults = await fetchCraftAPI(
	`https://cms.theadhocracy.co.uk/search/reviews?q=${paramQuery}&m=${paramTypes}&r=${range}`
);

// #4 Set UI state

// Selected filters
let validTypes = new Set();

if (params && paramTypes) {
	searchResults.map((result: any) => {
		validTypes.add(result.type.slug);
	});
}

// Filter out any results that do not match selected rating range
const filteredResults = searchResults.filter((result: any) => {
	if (range) result.rating >= paramMin && result.rating <= paramMax;
	return true;
});

// #5 Handle new search query
if (Astro.request.method === "POST") {
	try {
		const data = await Astro.request.formData();

		const query = data.get("search");
		const min = data.get("min");
		const max = data.get("max");

		// Work out which media types are selected
		let types: string[] = [];
		mediaTypes.forEach((type: any) => {
			if (data.get(type.slug)) {
				types.push(type.slug);
			}
		});

		const searchQuery = `/reviews?query=${query}&type=${types.join("|")}&min=${min}&max=${max}#search`;

		// Redirect with new search term
		return Astro.redirect(searchQuery);
	} catch (error) {
		if (error instanceof Error) {
			console.error(error.message);
		}
	}
}
---

<Layout title="Reviews">
	<main id="content">
		<header>
			<h1>Latest Reviews</h1>
		</header>
		<section class="content-grid">
			{
				reviews.map((review: any) => {
					return <Card post={review} type="review" />;
				})
			}
		</section>
		<a class="bold-link" href="/reviews/1"> Explore All Reviews? </a>
		<p class="banner-text">
			⬇ Otherwise, you can <a href="#search">search reviews</a> or check out the
			latest updates to <a href="#series">series</a> and <a href="#collections"
				>collections</a
			> ⬇
		</p>
		<h2 id="series">Series Updates</h2>
		<section class="content-grid">
			{
				series.map((review: any) => {
					return <Card post={review} type="review" />;
				})
			}
		</section>
		<h2 id="collections">Collection Updates</h2>
		<section class="content-grid">
			{
				collections.map((review: any) => {
					return <Card post={review} type="review" />;
				})
			}
		</section>
		<h2 id="search">Search All Reviews</h2>
		<search role="search">
			<form class="search-form" method="post">
				<input
					type="search"
					name="search"
					placeholder={`Search reviews`}
					aria-labelledby="search"
					value={paramQuery}
				/>
				<div>
					<button type="reset" title="Reset search">
						<span role="img" aria-label="Reset search"> 🔄 </span>
					</button>
					<button type="submit" title="Submit search">
						<span role="img" aria-label="Submit search"> ▶ </span>
					</button>
				</div>
				<fieldset>
					<legend>Media:</legend>
					{
						mediaTypes?.map((type: any) => {
							const id = type.id;

							// Check whether a filter is selected
							const isInTypeSelection = params.get("type")?.includes(type.slug);

							// Determine total based on if it is a valid filter or not
							const total =
								validTypes.size > 0 && !validTypes?.has(type.slug)
									? 0
									: type.total;

							return (
								<label
									for={`check_${id}`}
									data-empty={total === 0 ? "true" : "false"}
								>
									<input
										type="checkbox"
										id={`check_${id}`}
										name={type.slug}
										checked={isInTypeSelection}
									/>
									{type.title} <span>{total}</span>
								</label>
							);
						})
					}
				</fieldset>
				<SearchRating min={paramMin} max={paramMax} />
			</form>
			<section class="search-results">
				{
					filteredResults?.map((result: any) => {
						const type =
							mediaOptions[result.type.slug as keyof typeof mediaOptions];
						const rating = getStarRating(result.rating, 6, false);

						return (
							<article>
								<header>
									<span role="img" aria-label={type.title}>
										{type.icon}
									</span>
									<h2>{result.title}</h2>
									<a href={result.uri}>
										Read Review{" "}
										<span role="img" aria-hidden="true">
											↬
										</span>
									</a>
								</header>
								<Fragment set:html={result.snippet} />
								<footer>
									<dl>
										<span>
											<dt>Rating:</dt>
											<dd>{rating}</dd>
										</span>
										<span>
											<dt>Reviewed:</dt>
											<dd>
												<time datetime={result.date.html}>
													{result.date.date}
												</time>
											</dd>
										</span>
										{result.series.length > 0 && (
											<span>
												<dt>Series:</dt>
												<dd>
													<ul role="list">
														{result.series.map((series: any) => {
															return (
																<li class="series">
																	<a
																		href={`/review/series/${result.type.slug}/${series.slug}`}
																	>
																		{series.title}
																	</a>
																</li>
															);
														})}
													</ul>
												</dd>
											</span>
										)}
										{result.collections.length > 0 && (
											<span>
												<dt>Collections:</dt>
												<dd>
													<ul role="list">
														{result.collections.map((collection: any) => {
															return (
																<li>
																	<a
																		href={`/review/collection/${collection.slug}`}
																	>
																		{collection.title}
																	</a>
																</li>
															);
														})}
													</ul>
												</dd>
											</span>
										)}
									</dl>
								</footer>
							</article>
						);
					})
				}
				{
					searchResults?.length === 0 && (
						<p>Sorry, I don't seem to have reviewed that... yet!</p>
					)
				}
			</section>
		</search>
	</main>
</Layout>

<script is:inline>
	// Reset
	const resetButton = document.querySelector("button[type='reset']");

	resetButton.addEventListener("click", () => {
		window.location.search = "";
	});
</script>

<style is:global>
	/* Header */
	.review-header > div {
		max-width: var(--main);
		padding-bottom: 1rem;
	}

	/* Series & Collections */

	.article .collections a,
	.article .collections a:visited {
		display: inline-block;
		padding: 0.5rem;
		border: 2px solid var(--blue);
		border-radius: 6px;
		text-decoration: none;
		line-height: 0.6;
		color: var(--blue);
	}

	.collections a + a {
		margin-left: 1rem;
	}

	.article .review-header p.collections a:hover,
	.article .review-header p.collections a:focus {
		font-style: normal;
		letter-spacing: normal;
		color: #ffffff;
		background-color: var(--blue);
	}

	/* Series Navigation */

	.series-nav {
		width: var(--main);
		max-width: calc(100% + 1rem);
	}

	nav.series-nav ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		align-items: baseline;
		margin-left: -1rem;
		margin-bottom: -0.5rem;
	}

	.series-nav ul li {
		margin: 0;
		margin-left: 1rem;
		margin-bottom: 0.5rem;
		padding: 0;
	}

	.series-nav li a {
		display: inline-block;
		padding: 0.5rem;
		border: 2px solid var(--green);
		border-radius: 6px;
		text-decoration: none;
		line-height: 0.6;
		color: var(--green);
	}

	.article nav.series-nav ul li a:hover {
		font-style: normal;
		letter-spacing: normal;
		background-color: var(--green);
		color: #ffffff;
	}

	.series-nav a.active-series,
	.series-nav a.active-series:visited,
	.series-nav a.active-series:active {
		background-color: var(--green);
		color: #ffffff;
	}

	.series-nav ul:hover a.active-series {
		background-color: #ffffff;
		color: var(--green);
	}
</style>

<style>
	/* TODO: Consider combining this and /search page styles; possible components */
	:root {
		--font-serif: "Sitka Text", Charter, "Bitstream Charter", Cambria, serif;
		--font-sans: "Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Cantarell",
			"Fira Sans", "Droid Sans", "Helvetica Neue", sans-serif;
	}

	@keyframes RainbowRoad {
		from {
			background-position: left center;
		}

		to {
			background-position: right center;
		}
	}

	/* TODO: Remove this once global styles are determined */
	:global(#content) {
		background-color: transparent;
	}

	.search-form {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.4rem;
		align-items: center;
		padding-block: 1rem 1.5rem;

		input[type="search"] {
			min-width: min(80vw, 15rem);
			flex-grow: 1;
			border-radius: 6px;
			border: double 3px transparent;
			padding: 0.5rem;
			background-clip: padding-box, border-box;
			background-image: linear-gradient(#ffffff, #ffffff),
				linear-gradient(90deg, var(--orange), var(--yellow));
			background-origin: border-box;
			color: var(--darkgrey);

			&:focus {
				background-image: linear-gradient(#ffffff, #ffffff),
					linear-gradient(
						90deg,
						var(--orange) 20%,
						var(--yellow),
						var(--blue),
						var(--lightblue),
						var(--green),
						var(--yellow),
						var(--orange),
						var(--pink),
						var(--pink),
						var(--orange) 75%
					);
				background-position: right center;
				background-size: 400% auto;
				animation: RainbowRoad 5000ms ease-in-out infinite;
				outline: none;
			}
		}

		> div {
			display: flex;
			gap: 0.4rem;
			max-width: max-content;
			margin-inline-start: auto;
		}

		button {
			font-size: 1.2rem;
			padding: 0.3rem;
			border: 0;
			background-color: var(--blue);
			border-radius: 3px;
			cursor: pointer;
			font-family: "Segoe UI Emoji";
		}

		fieldset {
			display: flex;
			flex-wrap: wrap;
			gap: 0.6rem 0.6rem;
			width: 100%;
			margin: 0;
			padding: 0;
			border: none;
			font-size: 0.8rem;

			legend {
				margin-block-end: 0.4rem;
				font-family: var(--font-serif);
				font-weight: bold;
			}

			label {
				position: relative;
				padding-inline-start: 0.4rem;
				outline: 2px solid var(--green);
				outline-offset: -2px;
				background-color: white;

				input[type="checkbox"] {
					position: absolute;
					inset: 0;
					opacity: 0;
					margin: 0;
					width: 100%;
				}

				span {
					display: inline-flex;
					justify-content: center;
					align-items: center;
					width: 2rem;
					height: 1.5rem;
					margin-inline-start: 1rem;
					border: 2px solid var(--green);
					background-color: var(--green);
				}
			}

			label:has(:checked) {
				outline-color: var(--yellow);
				background-color: var(--yellow);

				span {
					border-color: var(--yellow);
					background-color: white;
				}
			}

			label[data-empty="true"]:not(:has(:checked)) {
				outline-color: var(--grey);

				span {
					border-color: var(--grey);
					background-color: var(--grey);
				}
			}

			label:has(:disabled) {
				display: none;

				@media (width > 800px) {
					display: block;
				}
			}

			label * {
				cursor: pointer;
			}
		}
	}

	.search-results {
		display: flex;
		flex-direction: column;
		margin-block-start: 1rem;
		font-family: var(--font-serif);

		background-color: white;
		padding: 1rem;
		border-radius: 6px;

		article {
			--content-padding: 0;

			@media (width > 450px) {
				--content-padding: 2.4rem;
			}

			padding-block: 0.75rem 1rem;
			border-block-start: 3px solid var(--grey);

			&:first-of-type {
				border: none;
			}

			header {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.25rem 1rem;
				margin-block-end: 0.25rem;

				h2 {
					flex-grow: 1;
					margin-block: 0;
					line-height: 1.2;
					font-family: var(--font-sans);
				}

				a {
					color: #e3013d;
					text-decoration-style: double;
					text-underline-offset: 0.1em;
					text-decoration-thickness: 0.1em;
				}

				a:hover,
				a:focus-visible {
					text-underline-offset: 0.25em;
				}

				span {
					place-self: start;
					line-height: 2.12;
				}
			}

			& > :global(p) {
				max-width: 46em;
				margin-block: 0;
				padding-inline: var(--content-padding);
				font-style: italic;
				font-synthesis-style: none;
			}

			footer {
				padding-block-start: 0.5rem;
				padding-inline: var(--content-padding);
			}

			dl,
			ul,
			dl > span {
				display: flex;
				flex-wrap: wrap;
				list-style: none;
				gap: 0 1rem;
				padding: 0;
				margin: 0;
			}

			ul {
				gap: 0.25rem 0.5rem;
				font-size: 0.8rem;
				place-self: center;

				li {
					--currentBGColor: var(--yellow);

					padding-inline: 0.2rem;
					background-color: var(--currentBGColor);

					a {
						color: black;
						text-decoration: none;
					}

					&:has(a:hover, a:focus) {
						background-color: color-mix(
							in srgb,
							var(--currentBGColor),
							white 50%
						);
					}
				}

				.series {
					--currentBGColor: var(--green);
				}
			}

			dl > span {
				gap: 0 0.25rem;
				flex-wrap: nowrap;
			}

			dt {
				white-space: nowrap;
				font-weight: bold;
			}

			dd {
				display: flex;
			}
		}
	}
</style>
