---
import Calendar from "@/components/Calendar.astro";
import Card from "@/components/Card.astro";
import Layout from "@/layouts/Layout.astro";
import { fetchCraftAPI } from "@/utilities/craft";
import type { GetStaticPaths } from "astro";

// Generate static pages
export const getStaticPaths = (async ({ paginate }) => {
	const journals = await fetchCraftAPI("journals.json");

	return paginate(journals, { pageSize: 1000 });
}) satisfies GetStaticPaths;

// Handle props
const { page } = Astro.props;

// Sort calendar by year and then by month
const sortedCalendar: any = page.data.reduce((group: any, item: any) => {
	if (!group.get(item.date.year)) {
		group.set(item.date.year, new Map());
	}

	if (!group.get(item.date.year).get(item.date.monthName)) {
		group.get(item.date.year).set(item.date.monthName, []);
	}

	group.get(item.date.year).get(item.date.monthName).push(item);

	return group;
}, new Map());
---

<Layout title="Journal">
	<main id="content">
		<header>
			<h1>Journal Entries</h1>
			<h2 class="subtitle">{new Date().getFullYear().toString()}</h2>
		</header>
		<section class="content-grid">
			{
				[...sortedCalendar.keys()].map((year: any) => {
					// Do not show the current year as a divider
					const currentYear = new Date().getFullYear().toString();

					const yearData = sortedCalendar.get(year);

					return (
						<>
							{currentYear !== year && (
								<div class="year-break">
									<h2>{year}</h2>
								</div>
							)}
							{[...yearData.keys()].map((month: any) => {
								// Create array of journal entries for the current month + year
								const entries = yearData.get(month).map((day: any) => {
									return {
										day: day.date.day,
										slug: day.slug,
									};
								});

								const monthData = yearData.get(month);

								return (
									<>
										<div class="journal-section">
											<h3>
												{month} {year}
											</h3>
											<Calendar
												month={month}
												year={year}
												entryArray={entries}
											/>
										</div>
										{monthData.map((day: any) => {
											return <Card post={day} type="journal" />;
										})}
									</>
								);
							})}
						</>
					);
				})
			}
		</section>
	</main>
</Layout>
