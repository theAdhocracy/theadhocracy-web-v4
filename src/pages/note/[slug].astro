---
import type { GetStaticPaths } from "astro";
import metadata from "@/data/metadata.json";

import Discovery from "@/components/Discovery.astro";
import RelatedContent from "@/components/RelatedContent.astro";
import Layout from "@/layouts/Layout.astro";
import { fetchCraftAPI } from "@/utilities/craft";

// Generate static pages
export const getStaticPaths = (async () => {
	const notes = await fetchCraftAPI("notes.json");

	return notes.map((item: any, index: number) => {
		return {
			params: {
				slug: item.slug,
			},
			props: {
				note: item,
				context: {
					next:
						index === 0
							? null
							: {
									slug: notes[index - 1].slug,
									title: notes[index - 1].title,
									desc: notes[index - 1].snippet,
								},
					prev:
						index === notes.length - 1
							? null
							: {
									slug: notes[index + 1].slug,
									title: notes[index + 1].title,
									desc: notes[index + 1].snippet,
								},
				},
			},
		};
	});
}) satisfies GetStaticPaths;

// Fetch & modify prop data
const { note, context } = Astro.props as any;

const { body } = note;

// Handle webmentions
// TODO: Return to this and refactor it!
const path = Astro.url.pathname;
const targetUrl = `https://theadhocracy.co.uk${path}`;

const wmData = await fetch(
	`https://webmention.io/api/mentions.jf2?target[]=${targetUrl}&target[]=${targetUrl}/`,
);
const response = await wmData.json();

const webmentions =
	response.name == "Webmentions"
		? response.children.map((mention: any) => {
				return {
					type: mention.type,
					author: mention.author,
					url: mention.url,
					published: mention.published,
					received: mention["wm-received"],
					id: mention["wm-received"],
					source: mention["wm-source"],
					target: mention["wm-target"],
					protocol: mention["wm-protocol"],
					summary: {
						type: mention.summary?.["content-type"],
						value: mention.summary?.value,
					},
					content: mention.content,
					bookmark: mention["bookmark-of"],
					reply: mention["in-reply-to"],
					like: mention["like-of"],
					repost: mention["repost-of"],
					mention: mention["mention-of"],
					rsvp: mention.rsvp,
					property: mention["wm-property"],
					private: mention["wm-private"],
					rels: mention.rels,
				};
			})
		: [];
---

<Layout
	title={note.title}
	meta={{
		desc: note.snippet,
		type: "article",
		category: note.silo,
		published: note.date.date,
		updated: note.updated.date,
		tags: note.tags,
	}}
>
	<main id="content" class="h-entry e-content">
		<article class="note">
			<header>
				<h1 class="p-name">
					{note.title}
				</h1>
				<aside class="details">
					<dl>
						<span>
							<dt>Original Author:</dt>
							<dd>
								{note.attribution}
								<a class="callout" href={note.source}>Read Original Article ↬</a
								>
							</dd>
						</span>

						{
							note.updated?.date !== note.date.date && (
								<span>
									<dt>Updated:</dt>
									<dd>
										<time class="dt-updated" datetime={note.updated.html}>
											{note.updated.date}
										</time>
									</dd>
								</span>
							)
						}
						<span>
							<dt>Published:</dt>
							<dd>
								<time class="dt-published" datetime={note.date.html}>
									{note.date.date}
								</time>
							</dd>
						</span>
						{
							note.categories.length === 1 && (
								<span>
									<dt>Category:</dt>
									<dd>
										{note.categories.map((category: string) => (
											<a
												href={`/search?query=&filter=${category}`}
												class="tag p-category"
											>
												{category}
											</a>
										))}
									</dd>
								</span>
							)
						}
						{
							note.categories.length > 1 && (
								<span>
									<dt>Categories:</dt>
									<dd>
										<ul role="list">
											{note.categories.map((category: string) => (
												<li>
													<a
														href={`/search?query=&filter=${category}`}
														class="tag p-category"
													>
														{category}
													</a>
												</li>
											))}
										</ul>
									</dd>
								</span>
							)
						}
						<span>
							<dt>Tags:</dt>
							<dd>
								<ul role="list">
									{
										note.tags.map((tag: string) => (
											<li>
												<a href={`/search?query=${tag}`} class="tag p-category">
													{tag}
												</a>
											</li>
										))
									}
								</ul>
							</dd>
						</span>
					</dl>
				</aside>
			</header>
			<Fragment set:html={body} />
		</article>
		<Discovery context={context} title="Notes" url="note" />
		<RelatedContent webmentions={webmentions} />
		<section class="microformats">
			<ul>
				<li class="p-summary">{note.snippet}</li>
				<li>
					<time class="dt-updated" datetime={note.updated.html}>
						{note.updated.date}
					</time>
				</li>
				<li class="h-card">
					<a rel="author" class="p-name p-author u-url" href={metadata.siteUrl}>
						{metadata.author}
					</a>
					<img
						class="u-photo"
						src="https://cms.theadhocracy.co.uk/assets/theadhocracy/website/murray-headshot-square.jpg"
						alt="Murray Champernowne."
					/>
				</li>
			</ul>
			<a class="u-url" href={`${metadata.siteUrl}/note/${note.slug}`}>
				Note permalink
			</a>
		</section>
	</main>
</Layout>

<style is:global>
	/* TODO: Remove this once global styles are determined */
	#content {
		background-color: transparent;

		/* Determine Grid Widths */
		--main: 40rem;
		--aside: 20rem;
		--gutter: 10rem;
		--full-width: calc(var(--main) + (2 * var(--aside)) + (2 * var(--gutter)));
		--part-span: calc(var(--main) + var(--aside));
		--breakout: calc(var(--main) + 2.5rem);
	}

	.note {
		--gap: 1em;
		--font-serif: "Sitka Text", Charter, "Bitstream Charter", Cambria, serif;
		--font-sans:
			"Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Cantarell", "Fira Sans",
			"Droid Sans", "Helvetica Neue", sans-serif;

		display: block;
		font-family: "Sitka Text", Charter, "Bitstream Charter", Cambria, serif;
		line-height: 2;

		header {
			--gap: 1.5em;

			width: 100%;
			max-width: 20ch;
			min-width: min(95dvw, 40rem);
			margin-inline: auto;

			& + * {
				--gap: 0.5em;
			}
		}

		h1 {
			display: flex !important; /* TODO: remove */
			flex-direction: column;
			max-width: 40rem;
			margin: 0 auto !important; /* TODO: remove */
			font-size: 2.75rem !important;
			line-height: 1.25;
		}

		h1,
		h2,
		h3,
		h4,
		h5,
		h6 {
			font-family:
				"Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Cantarell", "Fira Sans",
				"Droid Sans", "Helvetica Neue", sans-serif;
			text-wrap: balance;
		}

		p,
		li {
			font-size: 1.15rem;
		}

		img {
			margin-inline: auto;
		}

		img + figcaption {
			max-width: max-content;
			margin-inline: auto;
			margin-block-start: 1rem;
			font-style: italic;
			font-synthesis-style: none; /* stops emoji from being italicised */
		}

		& > hr,
		& > hr + * {
			--gap: 2.5rem;
		}

		& > *:not(aside, figure, h1, h2, h3, h4, h5, h6, pre, header) {
			max-width: 40rem;
			margin-inline: auto;
		}

		& > :is(aside, figure, hr, pre) {
			max-width: 50em;
			margin-inline: auto;
		}

		dl {
			display: flex;
			flex-wrap: wrap;
			gap: 0 1rem;

			span {
				display: flex;
				gap: 0.15rem;
				align-items: center;
			}
		}

		dt {
			font-weight: bold;
			white-space: nowrap;
		}

		ul[role="list"] {
			display: flex;
			flex-wrap: wrap;
			padding: 0;
			list-style: none;
		}

		blockquote {
			max-width: var(--breakout);
			margin-block: 2rem;
			margin-inline: auto;
			padding-inline: 1rem;
			border-inline-start: 4px solid var(--green);
			font-style: italic;
		}

		pre {
			padding: 1rem 3rem;
			overflow-x: auto;
			background-color: var(--darkgrey);
			border-left: 5px solid var(--orange);
			border-image: linear-gradient(180deg, var(--orange), var(--yellow)) 1;
			color: var(--yellow);
			line-height: 2.2;
			tab-size: 4;
			white-space: pre;
		}

		code:not(:is(pre code)) {
			padding: 0 0.2em;
			color: #117f6b;

			font-weight: bold;
		}

		sup {
			scroll-margin-top: 3rem;
		}

		a {
			color: #e0043f;
			text-underline-offset: 0.1em;
			text-decoration-thickness: 0.1em;
		}

		a:hover,
		a:focus-visible {
			text-underline-offset: 0.25em;
		}

		kbd {
			border: 1px solid var(--grey);
			padding: 0.1em 0.3em 0;
			border-radius: 0.25rem;
			color: #a41515;
		}

		.details {
			max-width: 35rem;
			margin-inline: auto;

			a {
				color: #5d7505;
			}
		}
	}

	.note > * + * {
		margin-block-start: var(--gap);
	}

	.tag {
		padding: 0.2rem 0.5rem;
		font-size: 0.85rem;
		text-decoration-style: dotted;
		text-underline-offset: 0.25em;
	}

	.callout {
		margin-inline-start: 1rem;
		padding: 0.4rem 0.5rem 0.25rem;
		background-color: var(--orange);
		color: #000 !important;
		font-size: 0.85rem;
		text-decoration: none;
	}

	/* Make the "original author" line full width */
	dl span:has(.callout) {
		flex-basis: 100%;
	}
</style>
